  "conformance": {
    "levels": [
      "manifest",
      "contract"
    ],
    "commands": [
      "./project.sh check"
    ],
    "validExamples": [
      "examples/default.json"
    ],
    "invalidExamples": [
      "examples/invalid-unknown-rule.json"
    ]
  },
  "mappings": [
    {
      "standard": "wellmanifest.dsl/manifest/v1",
